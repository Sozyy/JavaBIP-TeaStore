-- notes sur claude
-- physical ne donne pas de componentType d'après Anna


-- =====================================================================
-- chips_to_javabip.atl
--
-- Transformation Chips -> JavaBIP, palier 1 :
--   * Chaque logical_declaration / physical_declaration -> ComponentType                   ~
--   * Pour chaque paramètre d'entrée   : 1 State + 1 Port + 1 Transition                   non ?
--   * Pour chaque output / actuator    : 1 State + 1 Port + 1 Transition                   non ?
--   * Pour chaque sensor (physical)    : 1 State + 1 Port (spontaneous) + 1 Transition     pas besoin
--   * Boucle : INIT -> step_1 -> step_2 -> ... -> step_N -> INIT                           ui
--   * GlueSpec vide (palier 2 ajoutera les feeding_*)                                      ui
--   * object_declaration et collective_function_definition : ignorées                      ui
--
-- Compatible avec le runner emftvm.java fourni.
-- =====================================================================

module chips_to_javabip;
create OUT : JavaBIP from IN : Chips;

-- =====================================================================
-- HELPERS OCL
-- =====================================================================

-- Toutes les déclarations qu'on transforme en ComponentType.
-- On se contente de logical_declaration et physical_declaration.
helper context Chips!program def: blockDeclarations() : Sequence(OclAny) =
    self.system.system_statements
        ->select(s |
              s.oclIsKindOf(Chips!logical_declaration)
           or s.oclIsKindOf(Chips!physical_declaration))
        ->asSequence();

-- Discriminant logical/physical -- évite de tester deux fois oclIsKindOf.
helper context OclAny def: isPhysicalDecl() : Boolean =
    self.oclIsKindOf(Chips!physical_declaration);

-- Nettoyage de noms : enlève espaces et caractères non identifiants Java.
-- Utilisé pour "redirection dp" -> "redirection_dp".
helper context String def: sanitize() : String =
    self.replaceAll(' ', '_').replaceAll('-', '_');

-- Nom du composant = nom de la variable déclarée.
-- Une logical_declaration a une référence "variable" -> system/logical (qui hérite
-- de variables/variable et possède donc l'attribut "name").
helper context OclAny def: componentName() : String =
    self.variable.name.sanitize();

-- "Steps" d'une déclaration = séquence ordonnée des éléments qui produisent
-- chacun (1 State, 1 Port, 1 Transition).
-- L'ordre choisi détermine la forme de la boucle :
--   sensors -> parameters -> outputs -> actuators
-- (les flux entrants d'abord, les flux sortants ensuite).
helper context OclAny def: steps() : Sequence(OclAny) =
    let sensors : Sequence(OclAny) =
        if self.isPhysicalDecl() then
            self.def.sensor->asSequence()
        else
            Sequence{}
        endif
    in
    let params : Sequence(OclAny) =
        self.def.parameters->asSequence()
    in
    let outputs : Sequence(OclAny) =
        self.def.outputs->asSequence()
    in
    let actuators : Sequence(OclAny) =
        if self.isPhysicalDecl() then
            self.def.actuator->asSequence()
        else
            Sequence{}
        endif
    in
    sensors->union(params)->union(outputs)->union(actuators);

-- Classification d'un step en "entrée" vs "sortie", pour choisir
-- le préfixe du port et du nom de transition.
helper context OclAny def: isInputStep() : Boolean =
       self.oclIsKindOf(Chips!logical_parameter)
    or self.oclIsKindOf(Chips!physical_parameter);

helper context OclAny def: isSensorStep() : Boolean =
    -- Un sensor est un physical_parameter, mais on le distingue des paramètres
    -- logiques d'un physical_definition par le fait qu'il est rangé dans
    -- la collection "sensor" du conteneur, donc on regarde la classe.
    self.oclIsKindOf(Chips!physical_parameter);

helper context OclAny def: isActuatorStep() : Boolean =
    self.oclIsKindOf(Chips!physical_output);

-- Nom de l'état associé au step : "<name>_RCVD" ou "<name>_SENT".
helper context OclAny def: stateName() : String =
    if self.isInputStep() then
        self.name.sanitize() + '_RCVD'
    else
        self.name.sanitize() + '_SENT'
    endif;

-- Nom du port associé au step.
helper context OclAny def: portName() : String =
    if self.isSensorStep() then
        'sense_' + self.name.sanitize()
    else if self.isInputStep() then
        'recv_' + self.name.sanitize()
    else if self.isActuatorStep() then
        'actuate_' + self.name.sanitize()
    else
        'send_' + self.name.sanitize()
    endif endif endif;

-- Type du port : spontaneous pour les sensors (déclenchement autonome
-- du capteur physique), enforceable partout ailleurs.
helper context OclAny def: portTypeIsSpontaneous() : Boolean =
    self.isSensorStep();

-----------------
-- Partie Glue --
-----------------

-- Récupère les feeding_logical_* qui sont au NIVEAU RACINE du system
-- (donc pas à l'intérieur d'un foreach) ET dont le feeder est un
-- int/float/bool_logical_output (donc PAS une constante, PAS une
-- expression système, PAS un collective_cast).
helper context Chips!program def: eligibleFeedings() : Sequence(OclAny) =
    self.system.system_statements
        ->select(s | s.isFeedingLogical())
        ->select(s | s.feeder.isOutputFeeder())
        ->asSequence();

-- Discriminant : s'agit-il d'un feeding_logical_int/float/bool ?
-- On regroupe les trois pour éviter trois sélections séparées.
helper context OclAny def: isFeedingLogical() : Boolean =
       self.oclIsKindOf(Chips!feeding_logical_int)
    or self.oclIsKindOf(Chips!feeding_logical_float)
    or self.oclIsKindOf(Chips!feeding_logical_bool);

-- Discriminant : le feeder est-il un output (donc un vrai PortRef côté JavaBIP) ?
-- Si c'est une constante (direct_int), une variable système, ou un collective_cast,
-- on dit non — ces cas-là n'ont pas de port source.
helper context OclAny def: isOutputFeeder() : Boolean =
       self.oclIsKindOf(Chips!int_logical_output)
    or self.oclIsKindOf(Chips!float_logical_output)
    or self.oclIsKindOf(Chips!bool_logical_output);

-- À partir d'un feeding_*, extraire le ComponentType cible (côté eater).
-- L'eater est un objet (logical_eater, physical_eater) qui contient une
-- variable_expression pointant vers la variable d'instance (umachine, wpservice...).
-- La variable a un attribut inverse "declaration" (eOpposite) pointant vers la
-- system_declaration correspondante, qui sera transformée par notre matched rule.
helper context OclAny def: eaterComponent() : OclAny =
    self.eater.variable_expression.variable.declaration;

helper context OclAny def: eaterStep() : OclAny =
    self.eater.parameter;

-- Côté feeder : la variable_expression du feeder pointe sur l'instance source.
helper context OclAny def: feederComponent() : OclAny =
    self.feeder.variable_expression.variable.declaration;

helper context OclAny def: feederStep() : OclAny =
    self.feeder.output;


-- =====================================================================
-- RÈGLE PRINCIPALE : program -> JavaBIPModel
-- =====================================================================

rule Program2Model {
    from
        p : Chips!program
    to
        m : JavaBIP!JavaBIPModel (
            name       <- p.fileName.sanitize(),
            components <- p.blockDeclarations(),
            glue       <- glueSpec
        ),
        glueSpec : JavaBIP!GlueSpec (
            -- DataWires : un par feeding_* éligible.
            dataWires <- p.eligibleFeedings()
                            ->collect(f | thisModule.FeedingToDataWire(f)),
            -- Requires : un par feeding_* éligible (sémantique « eater requiert feeder »).
            requires  <- p.eligibleFeedings()
                            ->collect(f | thisModule.FeedingToRequire(f)),
            accepts   <- Sequence{},
            synchrons <- Sequence{}
        )
}


-- =====================================================================
-- RÈGLES BLOC -> COMPONENTTYPE
--
-- Deux règles séparées (logical / physical) car :
--   * Le javaClassName diffère (préfixe chips.logical vs chips.physical).
--   * Un physical_definition expose en plus des sensor et actuator.
-- Les helpers steps()/stateName()/portName() unifient le traitement
-- côté contenu de la boucle, donc la duplication reste minimale.
-- =====================================================================

rule LogicalDeclaration2ComponentType {
    from
        d : Chips!logical_declaration
    to
        c : JavaBIP!ComponentType (
            name          <- d.componentName(),
            javaClassName <- 'chips.logical.' + d.componentName(),
            cardinality   <- '1',
            constructors  <- '()',
            initialState  <- initSt,
            -- L'état INIT en tête, puis tous les états _RCVD/_SENT issus des steps.
            -- collect() invoque la lazy rule StepState pour chaque step,
            -- en propageant un identifiant unique de bloc (d) pour éviter que
            -- deux blocs partagent les mêmes objets cibles.
            states        <- Sequence{initSt}
                                ->union(d.steps()->collect(s |
                                            thisModule.StepState(s, d))),
            ports         <- d.steps()->collect(s |
                                            thisModule.StepPort(s, d)),
            -- N+1 transitions pour N steps : on chaîne INIT -> step_1, step_1 -> step_2,
            -- ..., step_N -> INIT. La construction est faite par un helper qui
            -- produit une séquence de paires (sourceStep, targetStep).
            transitions   <- d.buildTransitionsFor(),
            guards        <- Sequence{},
            definitions   <- ''
        ),
        initSt : JavaBIP!State (
            name    <- 'INIT',
            initial <- true
        )
}

rule PhysicalDeclaration2ComponentType {
    from
        d : Chips!physical_declaration
    to
        c : JavaBIP!ComponentType (
            name          <- d.componentName(),
            javaClassName <- 'chips.physical.' + d.componentName(),
            cardinality   <- '1',
            constructors  <- '()',
            initialState  <- initSt,
            states        <- Sequence{initSt}
                                ->union(d.steps()->collect(s |
                                            thisModule.StepState(s, d))),
            ports         <- d.steps()->collect(s |
                                            thisModule.StepPort(s, d)),
            transitions   <- d.buildTransitionsFor(),
            guards        <- Sequence{},
            definitions   <- ''
        ),
        initSt : JavaBIP!State (
            name    <- 'INIT',
            initial <- true
        )
}


-- =====================================================================
-- LAZY RULES : un step -> un State, un Port
--
-- Le paramètre "owner" (d) sert d'identité : ATL mémoïse les lazy rules
-- par tuple d'arguments, donc deux appels distincts avec le même step mais
-- des owners différents produisent deux instances cibles différentes.
-- C'est essentiel sinon deux blocs ayant un paramètre "userID" partageraient
-- le même State, ce qu'on ne veut surtout pas.
-- =====================================================================

lazy rule StepState {
    from
        step : OclAny,
        owner : OclAny
    to
        s : JavaBIP!State (
            name    <- step.stateName(),
            initial <- false
        )
}

lazy rule StepPort {
    from
        step : OclAny,
        owner : OclAny
    to
        port : JavaBIP!Port (
            name <- step.portName(),
            type <- if step.portTypeIsSpontaneous() then
                        #spontaneous
                    else
                        #enforceable
                    endif
        )
}


-- =====================================================================
-- CONSTRUCTION DES TRANSITIONS
--
-- Une boucle à N+1 transitions pour N steps :
--   T0 : INIT       -> step_1   (port = portName(step_1))
--   T1 : step_1     -> step_2   (port = portName(step_2))
--   ...
--   T_{N-1} : step_{N-1} -> step_N
--   T_N : step_N    -> INIT     (port = "close_loop", transition interne)
--
-- En OCL, on construit la séquence d'indices [1..N+1] puis on appelle
-- une lazy rule TransitionAt qui regarde steps_(i-1) et steps_i.
-- Convention : index 0 = INIT, indices 1..N = steps()[i].
-- =====================================================================

helper context OclAny def: stepCount() : Integer =
    self.steps()->size();

helper context OclAny def: buildTransitionsFor() : Sequence(OclAny) =
    -- On parcourt les steps avec un compteur explicite.
    -- L'accumulateur est un Tuple { idx : Integer, transitions : Sequence }.
    -- À chaque step, on incrémente idx et on appende une nouvelle transition.
    let stepsSeq : Sequence(OclAny) = self.steps() in
    let result : TupleType(idx : Integer, transitions : Sequence(OclAny)) =
        stepsSeq->iterate(s;
            acc : TupleType(idx : Integer, transitions : Sequence(OclAny)) =
                Tuple{ idx = 0, transitions = Sequence{} } |
            Tuple{
                idx = acc.idx + 1,
                transitions = acc.transitions->append(
                    thisModule.TransitionToStep(self, s, acc.idx + 1))
            })
    in
    result.transitions->append(thisModule.LoopBackTransition(self));


-- Transition qui ARRIVE à un step donné.
--   * Si c'est le premier step (idx = 1), la source est INIT.
--   * Sinon, la source est le step précédent dans la séquence.
lazy rule TransitionToStep {
    from
        owner : OclAny,
        target_step : OclAny,
        idx : Integer
    to
        t : JavaBIP!Transition (
            name             <- 't' + idx.toString(),
            transitionMethod <- 'step' + idx.toString(),
            source           <- if idx = 1 then
                                    thisModule.resolveTemp(owner, 'initSt')
                                else
                                    let prevIdx : Integer = idx - 1 in
                                    let prevStep : OclAny = owner.steps()->at(prevIdx) in
                                    thisModule.StepState(prevStep, owner)
                                endif,
            target           <- thisModule.StepState(target_step, owner),
            port             <- thisModule.StepPort(target_step, owner),
            type             <- if target_step.portTypeIsSpontaneous() then
                                    #spontaneous
                                else
                                    #enforceable
                                endif
        )
}

-- Transition de bouclage : du dernier step retour à INIT, sans port (internal).
lazy rule LoopBackTransition {
    from
        owner : OclAny
    to
        t : JavaBIP!Transition (
            name             <- 'loop_back',
            transitionMethod <- 'loopBack',
            source           <- let lastStep : OclAny = owner.steps()->at(owner.stepCount()) in
                                thisModule.StepState(lastStep, owner),
            target           <- thisModule.resolveTemp(owner, 'initSt'),
            type             <- #internal
        )
}

-----------------
-- Partie Glue --
-----------------

-- Une PortRef = (ComponentType, Port). Mémoïsée par couple (component, step) pour
-- éviter de créer deux PortRef différentes pour la même paire.
lazy rule MakePortRef {
    from
        compDecl : OclAny,
        step : OclAny
    to
        pr : JavaBIP!PortRef (
            -- ATL résout compDecl vers le ComponentType produit par
            -- LogicalDeclaration2ComponentType ou PhysicalDeclaration2ComponentType.
            component <- compDecl,
            -- Le port est résolu par la lazy rule StepPort déjà existante
            -- du palier 1. Mémoïsation garantie pour la cohérence.
            port      <- thisModule.StepPort(step, compDecl)
        )
}

-- Un DataWire = (PortRef source, PortRef cible).
lazy rule FeedingToDataWire {
    from
        f : OclAny
    to
        dw : JavaBIP!DataWire (
            from <- thisModule.MakePortRef(f.feederComponent(), f.feederStep()),
            to   <- thisModule.MakePortRef(f.eaterComponent(), f.eaterStep())
        )
}

-- Un RequireRule sur l'effet = port de l'eater, avec cause = port du feeder.
-- Sémantique : « le port qui reçoit ne peut s'activer que si le port qui émet
-- s'active en même temps ». C'est la traduction naturelle de la sémantique
-- semi-synchrone Chips où un feeding établit un contrat de présence.
lazy rule FeedingToRequire {
    from
        f : OclAny
    to
        rr : JavaBIP!RequireRule (
            effect <- thisModule.MakePortRef(f.eaterComponent(), f.eaterStep()),
            causes <- Sequence{ thisModule.MakePortRef(f.feederComponent(),
                                                       f.feederStep()) }
        )
}