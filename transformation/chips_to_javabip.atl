-- =====================================================================
-- chips_to_javabip.atl
--
-- Transformation Chips -> JavaBIP
-- Paliers réalisés :
--   1  : logical_declaration / physical_declaration -> ComponentType avec
--        boucle d'états et transitions
--   2  : feeding_logical_* racine avec feeder *_logical_output 
--        -> DataWire + RequireRule
--   3  : extension aux feeding_physical_* et feeder *_physical_output
--   4a : déroulement des déclarations array
--        (cache[N] -> cache_0, cache_1, ...)
--
-- NOTE PALIER 4a : Les ComponentTypes array sont bien créés (N composants
-- par déclaration array). Mais le GlueSpec utilise toujours les déclarations
-- brutes via MakePortRef -> StepPort, donc les DataWires/RequireRules qui
-- référencent des arrays peuvent avoir leurs PortRef avec un component à nil.
-- Sera corrigé au palier 4b (foreach).
--
-- NOTES EMFTVM :
--   * Pas de qualification de type (Chips!"a::b::c" non supporté).
--     On utilise des noms simples (Chips!logical_declaration).
--   * Pour les classes dupliquées dans plusieurs sous-packages
--     (direct_int, int_variable_expression, int_assignment), on utilise
--     oclType().name = 'xxx' au lieu de oclIsKindOf.
--   * Sequence{1..n} non supporté : on utilise iterate à compteur explicite.
--   * resolveTemp ne fonctionne pas bien avec des lazy rules à plusieurs
--     paramètres. Pour partager un objet (initSt) entre lazy rules, on le
--     passe en paramètre.
-- =====================================================================

module chips_to_javabip;
create OUT : JavaBIP from IN : Chips;


-- =====================================================================
-- HELPERS GÉNÉRAUX (paliers 1 à 3)
-- =====================================================================

-- Toutes les déclarations qu'on transforme en ComponentType (logical + physical).
helper context Chips!program def: blockDeclarations() : Sequence(OclAny) =
    self.system.system_statements
        ->select(s |
              s.oclIsKindOf(Chips!logical_declaration)
           or s.oclIsKindOf(Chips!physical_declaration)
           or s.oclIsKindOf(Chips!object_declaration))
        ->asSequence();

-- Discriminant logical/physical.
helper context OclAny def: isPhysicalDecl() : Boolean =
    self.oclIsKindOf(Chips!physical_declaration);

-- Nettoyage de noms : remplace espaces et tirets par des underscores.
helper context String def: sanitize() : String =
    self.replaceAll(' ', '_').replaceAll('-', '_');

-- Nom du composant = nom de la variable déclarée, sanitizé.
helper context OclAny def: componentName() : String =
    self.variable.name.sanitize();

-- Séquence ordonnée des "steps" d'une déclaration :
--   sensors -> parameters -> outputs -> actuators
helper context OclAny def: steps() : Sequence(OclAny) =
    if self.isObjectDecl() then
        Sequence{}
    else
        let sensors : Sequence(OclAny) =
            if self.isPhysicalDecl() then
                self.def.sensor->asSequence()
            else
                Sequence{}
            endif
        in
        let params : Sequence(OclAny) =
            self.def.parameters->asSequence()
        in
        let outputs : Sequence(OclAny) =
            self.def.outputs->asSequence()
        in
        let actuators : Sequence(OclAny) =
            if self.isPhysicalDecl() then
                self.def.actuator->asSequence()
            else
                Sequence{}
            endif
        in
        sensors->union(params)->union(outputs)->union(actuators)
    endif;

helper context OclAny def: stepCount() : Integer =
    self.steps()->size();

-- Classification d'un step.
helper context OclAny def: isInputStep() : Boolean =
       self.oclIsKindOf(Chips!logical_parameter)
    or self.oclIsKindOf(Chips!physical_parameter);

helper context OclAny def: isSensorStep() : Boolean =
    self.oclIsKindOf(Chips!physical_parameter);

helper context OclAny def: isActuatorStep() : Boolean =
    self.oclIsKindOf(Chips!physical_output);

-- Nom de l'état associé à un step.
helper context OclAny def: stateName() : String =
    if self.isInputStep() then
        self.name.sanitize() + '_RCVD'
    else
        self.name.sanitize() + '_SENT'
    endif;

-- Nom du port associé à un step.
helper context OclAny def: portName() : String =
    if self.isSensorStep() then
        'sense_' + self.name.sanitize()
    else if self.isInputStep() then
        'recv_' + self.name.sanitize()
    else if self.isActuatorStep() then
        'actuate_' + self.name.sanitize()
    else
        'send_' + self.name.sanitize()
    endif endif endif;

-- Type du port : spontaneous pour les sensors, enforceable sinon.
helper context OclAny def: portTypeIsSpontaneous() : Boolean =
    self.isSensorStep();


-- =====================================================================
-- HELPERS PALIER 4a : DÉROULEMENT DES DÉCLARATIONS ARRAY
-- =====================================================================

-- Détecte si une déclaration est un tableau (au moins 1 dimension).
-- Le champ "dimensions" est une LISTE (upperBound -1 dans le métamodèle),
-- donc on teste avec ->isEmpty() au lieu de oclIsUndefined().
helper context OclAny def: isArrayDecl() : Boolean =
    not self.variable.dimensions->isEmpty();

-- Évalue la taille (1D) d'une déclaration array. On prend la première dimension.
-- Cas gérés : direct_int littéral, ou int_variable_expression vers une variable
-- système assignée à un direct_int.
-- Comme direct_int et int_variable_expression existent dans plusieurs
-- sous-packages, on identifie par oclType().name (chaîne de caractères).
helper context OclAny def: arraySize() : Integer =
    if self.variable.dimensions->isEmpty() then
        -1
    else
        let dim : OclAny = self.variable.dimensions->first() in
        if dim.oclType().name = 'direct_int' then
            dim.value
        else
            if dim.oclType().name = 'int_variable_expression' then
                dim.variable.resolveIntVar()
            else
                -1
            endif
        endif
    endif;

-- Résout la valeur d'une variable système entière en cherchant son
-- int_assignment dans le system. self est la variable cherchée.
helper context OclAny def: resolveIntVar() : Integer =
    let prog : Chips!program = Chips!program.allInstances()->asSequence()->first() in
    let assignments : Sequence(OclAny) =
        prog.system.system_statements
            ->select(s | s.oclType().name = 'int_assignment')
            ->select(a | a.lvalue.variable = self)
            ->asSequence()
    in
    if assignments->isEmpty() then
        -1
    else
        let firstAssign : OclAny = assignments->first() in
            if firstAssign.rvalue.oclType().name = 'direct_int' then
                firstAssign.rvalue.value
            else
                -1
            endif
    endif;

-- Construit récursivement la séquence [0, 1, ..., n-1].
-- Helper de module (sans context), appelable globalement par thisModule.
helper def: rangeUpTo(n : Integer) : Sequence(Integer) =
    if n <= 0 then
        Sequence{}
    else
        thisModule.rangeUpTo(n - 1)->append(n - 1)
    endif;

-- Pour une déclaration, retourne la séquence des éléments qui produiront
-- les ComponentTypes correspondants :
--   * Si scalaire : Sequence{decl} (sera résolue via matched rule).
--   * Si array évaluable : Sequence{ ArrayDeclAtIndex(decl,0), ..., ArrayDeclAtIndex(decl,n-1) }.
--   * Si array non évaluable : fallback scalaire (Sequence{decl}).
helper context OclAny def: expandedComponents() : Sequence(OclAny) =
    if self.isArrayDecl() then
        let n : Integer = self.arraySize() in
        if n <= 0 then
            Sequence{self}
        else
            thisModule.rangeUpTo(n)
                ->collect(i | thisModule.ArrayDeclAtIndex(self, i))
        endif
    else
        Sequence{self}
    endif;

-- HELPERS PALIER 5

helper context OclAny def: isObjectDecl() : Boolean =
    self.oclIsKindOf(Chips!object_declaration);



-- =====================================================================
-- HELPERS PALIERS 2/3 : SÉLECTION DES FEEDINGS POUR LE GLUE
-- =====================================================================

helper context OclAny def: isFeedingDataflow() : Boolean =
       self.oclIsKindOf(Chips!feeding_logical_int)
    or self.oclIsKindOf(Chips!feeding_logical_float)
    or self.oclIsKindOf(Chips!feeding_logical_bool)
    or self.oclIsKindOf(Chips!feeding_physical_int)
    or self.oclIsKindOf(Chips!feeding_physical_float)
    or self.oclIsKindOf(Chips!feeding_physical_bool);

helper context OclAny def: isFeedingPhysical() : Boolean =
       self.oclIsKindOf(Chips!feeding_physical_int)
    or self.oclIsKindOf(Chips!feeding_physical_float)
    or self.oclIsKindOf(Chips!feeding_physical_bool);

helper context OclAny def: isOutputFeeder() : Boolean =
       self.oclIsKindOf(Chips!int_logical_output)
    or self.oclIsKindOf(Chips!float_logical_output)
    or self.oclIsKindOf(Chips!bool_logical_output)
    or self.oclIsKindOf(Chips!int_physical_output)
    or self.oclIsKindOf(Chips!float_physical_output)
    or self.oclIsKindOf(Chips!bool_physical_output);

helper context Chips!program def: eligibleFeedings() : Sequence(OclAny) =
    self.system.system_statements
        ->select(s | s.isFeedingDataflow())
        ->select(s | s.feeder.isOutputFeeder())
        ->asSequence();

helper context Chips!program def: eligibleFeedingsForRequire() : Sequence(OclAny) =
    self.eligibleFeedings()
        ->select(f | not f.isFeedingPhysical())
        ->asSequence();

-- Extraction des PortRef pour les feedings.
helper context OclAny def: eaterComponent() : OclAny =
    self.eater.variable_expression.variable.declaration;

helper context OclAny def: eaterStep() : OclAny =
    self.eater.parameter;

helper context OclAny def: feederComponent() : OclAny =
    self.feeder.variable_expression.variable.declaration;

helper context OclAny def: feederStep() : OclAny =
    self.feeder.output;


-- =====================================================================
-- RÈGLE PRINCIPALE : program -> JavaBIPModel
-- =====================================================================

rule Program2Model {
    from
        p : Chips!program
    to
        m : JavaBIP!JavaBIPModel (
            name       <- p.fileName.sanitize(),
            -- Pour chaque déclaration : 1 composant si scalaire, N si array.
            -- flatten() aplatit la séquence-de-séquences en une séquence plate.
            components <- p.blockDeclarations()
                            ->collect(d | d.expandedComponents())
                            ->flatten(),
            glue       <- glueSpec
        ),
        glueSpec : JavaBIP!GlueSpec (
            dataWires <- p.eligibleFeedings()->collect(f | thisModule.FeedingToDataWire(f)),
            requires  <- p.eligibleFeedingsForRequire()->collect(f | thisModule.FeedingToRequire(f)),
            accepts   <- Sequence{},
            synchrons <- Sequence{}
        )
}


-- =====================================================================
-- MATCHED RULES PALIER 1 : DÉCLARATIONS SCALAIRES
-- =====================================================================
-- Ces règles s'appliquent automatiquement aux déclarations scalaires
-- (ou aux déclarations array dont la taille n'a pas pu être évaluée).
-- Pour les arrays évaluables, c'est ArrayDeclAtIndex qui prend le relais.

rule LogicalDeclaration2ComponentType {
    from
        d : Chips!logical_declaration
        (not d.isArrayDecl() or d.arraySize() <= 0)
    to
        c : JavaBIP!ComponentType (
            name          <- d.componentName(),
            javaClassName <- 'chips.logical.' + d.componentName(),
            cardinality   <- '1',
            constructors  <- '()',
            initialState  <- initSt,
            states        <- Sequence{initSt}
                                ->union(d.steps()->collect(s | thisModule.StepState(s, d))),
            ports         <- d.steps()->collect(s | thisModule.StepPort(s, d)),
            transitions   <- d.buildTransitionsFor(initSt),
            guards        <- Sequence{},
            definitions   <- ''
        ),
        initSt : JavaBIP!State (
            name    <- 'INIT',
            initial <- true
        )
}

rule PhysicalDeclaration2ComponentType {
    from
        d : Chips!physical_declaration
        (not d.isArrayDecl() or d.arraySize() <= 0)
    to
        c : JavaBIP!ComponentType (
            name          <- d.componentName(),
            javaClassName <- 'chips.physical.' + d.componentName(),
            cardinality   <- '1',
            constructors  <- '()',
            initialState  <- initSt,
            states        <- Sequence{initSt}
                                ->union(d.steps()->collect(s | thisModule.StepState(s, d))),
            ports         <- d.steps()->collect(s | thisModule.StepPort(s, d)),
            transitions   <- d.buildTransitionsFor(initSt),
            guards        <- Sequence{},
            definitions   <- ''
        ),
        initSt : JavaBIP!State (
            name    <- 'INIT',
            initial <- true
        )
}


-- =====================================================================
-- LAZY RULES PALIER 1 (scalaires) : un step -> 1 State, 1 Port
-- =====================================================================

lazy rule StepState {
    from
        step : OclAny,
        owner : OclAny
    to
        s : JavaBIP!State (
            name    <- step.stateName(),
            initial <- false
        )
}

lazy rule StepPort {
    from
        step : OclAny,
        owner : OclAny
    to
        port : JavaBIP!Port (
            name <- step.portName(),
            type <- if step.portTypeIsSpontaneous() then
                        #spontaneous
                    else
                        #enforceable
                    endif
        )
}


-- =====================================================================
-- CONSTRUCTION DES TRANSITIONS PALIER 1 (scalaires)
-- =====================================================================
-- On passe initSt en paramètre pour éviter resolveTemp (qui ne marche pas
-- bien chez nous) et pour partager la même instance entre les transitions.

helper context OclAny def: buildTransitionsFor(initSt : OclAny) : Sequence(OclAny) =
    let stepsSeq : Sequence(OclAny) = self.steps() in
    if stepsSeq->isEmpty() then
        Sequence{}
    else
        let result : TupleType(idx : Integer, transitions : Sequence(OclAny)) =
            stepsSeq->iterate(s;
                acc : TupleType(idx : Integer, transitions : Sequence(OclAny)) =
                    Tuple{ idx = 0, transitions = Sequence{} } |
                Tuple{
                    idx = acc.idx + 1,
                    transitions = acc.transitions->append(
                        thisModule.TransitionToStep(self, s, acc.idx + 1, initSt))
                })
        in
        result.transitions->append(thisModule.LoopBackTransition(self, initSt))
    endif;

lazy rule TransitionToStep {
    from
        owner : OclAny,
        target_step : OclAny,
        idx : Integer,
        initSt : OclAny
    to
        t : JavaBIP!Transition (
            name             <- 't' + idx.toString(),
            transitionMethod <- 'step' + idx.toString(),
            source           <- if idx = 1 then
                                    initSt
                                else
                                    let prevIdx : Integer = idx - 1 in
                                    let prevStep : OclAny = owner.steps()->at(prevIdx) in
                                    thisModule.StepState(prevStep, owner)
                                endif,
            target           <- thisModule.StepState(target_step, owner),
            port             <- thisModule.StepPort(target_step, owner),
            type             <- if target_step.portTypeIsSpontaneous() then
                                    #spontaneous
                                else
                                    #enforceable
                                endif
        )
}

lazy rule LoopBackTransition {
    from
        owner : OclAny,
        initSt : OclAny
    to
        t : JavaBIP!Transition (
            name             <- 'loop_back',
            transitionMethod <- 'loopBack',
            source           <- let lastStep : OclAny = owner.steps()->at(owner.stepCount()) in
                                thisModule.StepState(lastStep, owner),
            target           <- initSt,
            type             <- #internal
        )
}

-- RULE PALIER 5

rule ObjectDeclaration2ComponentType {
    from
        d : Chips!object_declaration
        (not d.isArrayDecl() or d.arraySize() <= 0)
    to
        c : JavaBIP!ComponentType (
            name          <- d.componentName(),
            javaClassName <- 'chips.object.' + d.componentName(),
            cardinality   <- '1',
            constructors  <- '()',
            initialState  <- initSt,
            states        <- Sequence{initSt},
            ports         <- Sequence{},
            transitions   <- Sequence{},
            guards        <- Sequence{},
            definitions   <- ''
        ),
        initSt : JavaBIP!State (
            name    <- 'INIT',
            initial <- true
        )
}


-- =====================================================================
-- LAZY RULES PALIER 4a : DÉCLARATIONS ARRAY
-- =====================================================================
-- Pour chaque déclaration array de taille N, on crée N ComponentTypes
-- nommés <name>_0, <name>_1, ..., <name>_{N-1}.
-- L'INIT est créé une seule fois comme cible secondaire et passé aux
-- transitions par paramètre (pas de resolveTemp, pas de mémoïsation à
-- problème).

lazy rule ArrayDeclAtIndex {
    from
        d : OclAny,
        i : Integer
    to
        c : JavaBIP!ComponentType (
            name          <- d.componentName() + '_' + i.toString(),
            javaClassName <- (if d.isPhysicalDecl() then 'chips.physical.'
                              else if d.isObjectDecl() then 'chips.object.'
                              else 'chips.logical.'
                              endif endif)
                             + d.componentName() + '_' + i.toString(),
            cardinality   <- '1',
            constructors  <- '()',
            initialState  <- initSt,
            states        <- Sequence{initSt}
                                ->union(d.steps()->collect(s | thisModule.ArrayStepState(s, d, i))),
            ports         <- d.steps()->collect(s | thisModule.ArrayStepPort(s, d, i)),
            transitions   <- d.buildArrayTransitions(i, initSt),
            guards        <- Sequence{},
            definitions   <- ''
        ),
        initSt : JavaBIP!State (
            name    <- 'INIT',
            initial <- true
        )
}

lazy rule ArrayStepState {
    from
        step : OclAny,
        owner : OclAny,
        idx : Integer
    to
        s : JavaBIP!State (
            name    <- step.stateName(),
            initial <- false
        )
}

lazy rule ArrayStepPort {
    from
        step : OclAny,
        owner : OclAny,
        idx : Integer
    to
        port : JavaBIP!Port (
            name <- step.portName(),
            type <- if step.portTypeIsSpontaneous() then
                        #spontaneous
                    else
                        #enforceable
                    endif
        )
}

helper context OclAny def: buildArrayTransitions(arrIdx : Integer, initSt : OclAny) : Sequence(OclAny) =
    let stepsSeq : Sequence(OclAny) = self.steps() in
    if stepsSeq->isEmpty() then
        Sequence{}
    else
        let result : TupleType(idx : Integer, transitions : Sequence(OclAny)) =
            stepsSeq->iterate(s;
                acc : TupleType(idx : Integer, transitions : Sequence(OclAny)) =
                    Tuple{ idx = 0, transitions = Sequence{} } |
                Tuple{
                    idx = acc.idx + 1,
                    transitions = acc.transitions->append(
                        thisModule.ArrayTransitionToStep(self, s, acc.idx + 1, arrIdx, initSt))
                })
        in
        result.transitions->append(thisModule.ArrayLoopBackTransition(self, arrIdx, initSt))
    endif;

lazy rule ArrayTransitionToStep {
    from
        owner : OclAny,
        target_step : OclAny,
        step_idx : Integer,
        arr_idx : Integer,
        initSt : OclAny
    to
        t : JavaBIP!Transition (
            name             <- 't' + step_idx.toString(),
            transitionMethod <- 'step' + step_idx.toString(),
            source           <- if step_idx = 1 then
                                    initSt
                                else
                                    let prevIdx : Integer = step_idx - 1 in
                                    let prevStep : OclAny = owner.steps()->at(prevIdx) in
                                    thisModule.ArrayStepState(prevStep, owner, arr_idx)
                                endif,
            target           <- thisModule.ArrayStepState(target_step, owner, arr_idx),
            port             <- thisModule.ArrayStepPort(target_step, owner, arr_idx),
            type             <- if target_step.portTypeIsSpontaneous() then
                                    #spontaneous
                                else
                                    #enforceable
                                endif
        )
}

lazy rule ArrayLoopBackTransition {
    from
        owner : OclAny,
        arr_idx : Integer,
        initSt : OclAny
    to
        t : JavaBIP!Transition (
            name             <- 'loop_back',
            transitionMethod <- 'loopBack',
            source           <- let lastStep : OclAny = owner.steps()->at(owner.stepCount()) in
                                thisModule.ArrayStepState(lastStep, owner, arr_idx),
            target           <- initSt,
            type             <- #internal
        )
}


-- =====================================================================
-- LAZY RULES PALIER 2/3 : DATAWIRE, PORTREF, REQUIRERULE
-- =====================================================================
-- ATTENTION : ces règles utilisent MakePortRef qui appelle StepPort(step, decl).
-- Pour les déclarations array (palier 4a), la résolution peut être imparfaite
-- car le palier 4a n'adapte pas encore les PortRef à pointer vers le bon
-- composant array_i. Sera corrigé au palier 4b.

lazy rule MakePortRef {
    from
        compDecl : OclAny,
        step : OclAny
    to
        pr : JavaBIP!PortRef (
            component <- compDecl,
            port      <- thisModule.StepPort(step, compDecl)
        )
}

lazy rule FeedingToDataWire {
    from
        f : OclAny
    to
        dw : JavaBIP!DataWire (
            from <- thisModule.MakePortRef(f.feederComponent(), f.feederStep()),
            to   <- thisModule.MakePortRef(f.eaterComponent(), f.eaterStep())
        )
}

lazy rule FeedingToRequire {
    from
        f : OclAny
    to
        rr : JavaBIP!RequireRule (
            effect <- thisModule.MakePortRef(f.eaterComponent(), f.eaterStep()),
            causes <- Sequence{ thisModule.MakePortRef(f.feederComponent(), f.feederStep()) }
        )
}